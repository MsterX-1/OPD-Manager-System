<UserControl x:Class="OpdManager.Presentation.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Patients" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="＋  New Patient"
                    Command="{Binding CreatePatientCommand}"
                    Style="{StaticResource DarkButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search + Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E2E6EA" BorderThickness="1" Padding="12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🔍"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#94A3B0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="#1A2530"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <Button Grid.Column="2" Content="Search"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource PrimaryButton}"/>
            <Button Grid.Column="4" Content="✕ Clear"
                    Command="{Binding ClearSearchCommand}"
                    Style="{StaticResource GhostButton}"/>
            <Button Grid.Column="6" Content="📋  View History"
                    Command="{Binding ViewHistoryCommand}"
                    Style="{StaticResource DarkButton}"/>
            <Button Grid.Column="8" Content="🗑  Delete"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButton}"/>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid ItemsSource="{Binding Patients}"
                      SelectedItem="{Binding SelectedPatient}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F2F4"
                      BorderThickness="0"
                      RowHeight="48" FontSize="13"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFBFC"
                      SelectionMode="Single"
                      CanUserResizeRows="False"
                      ColumnHeaderHeight="42">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="White"/>
                        <Setter Property="Foreground"      Value="#5A6A75"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="FontSize"        Value="11"/>
                        <Setter Property="Padding"         Value="14,0"/>
                        <Setter Property="BorderBrush"     Value="#E2E6EA"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"           Value="14,0"/>
                        <Setter Property="BorderThickness"   Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground"        Value="#1A2530"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF2FA"/>
                                <Setter Property="Foreground" Value="#1A2530"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding ViewHistoryCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full Name"
                                        Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding PhoneNumber}" Width="150"/>
                    <DataGridTextColumn Header="Date of Birth"
                                        Binding="{Binding DateOfBirth, StringFormat='MMM dd, yyyy'}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Registered"
                                        Binding="{Binding CreatedAt, StringFormat='MMM dd, yyyy'}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Notes"
                                        Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" Padding="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="#94A3B0">
                    <Run Text="Page "/><Run Text="{Binding CurrentPage}"/>
                    <Run Text=" of "/><Run Text="{Binding TotalPages}"/>
                    <Run Text="  ·  "/><Run Text="{Binding TotalCount}"/>
                    <Run Text=" patients"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="‹" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,4,0"/>
                    <Border Background="White" CornerRadius="6"
                            BorderBrush="#1A56A0" BorderThickness="1"
                            Width="32" Height="32" Margin="0,0,4,0">
                        <TextBlock Text="{Binding CurrentPage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#1A56A0"/>
                    </Border>
                    <Button Content="›" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource GhostButton}"
                            Padding="12,7"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
