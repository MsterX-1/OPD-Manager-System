<Window x:Class="OpdManager.Presentation.Views.AddEditDoctorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OpdManager.Presentation.Converters"
        Title="{Binding Title}"
        Height="500" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F7F9">

    <Window.Resources>
        <converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter"/>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A75"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Margin="24">
        <StackPanel>

            <TextBlock Text="{Binding Title}" FontSize="18"
                       FontWeight="Bold" Foreground="#1A2530"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Full Name *" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource PlaceholderTextBox}"
                     Tag="e.g. Dr. Ahmed Hassan"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Specialty *" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource PlaceholderTextBox}"
                     Tag="e.g. General Medicine"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Phone Number" Style="{StaticResource FL}"/>
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource PlaceholderTextBox}"
                     Tag="optional"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Working Hours" Style="{StaticResource FL}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding TimeOptions}"
                          SelectedItem="{Binding StartTime}"
                          Padding="12,10" FontSize="13"
                          BorderBrush="#E2E6EA">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TimeSpanTo12HourConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="1" Text="→"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#94A3B0"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding TimeOptions}"
                          SelectedItem="{Binding EndTime}"
                          Padding="12,10" FontSize="13"
                          BorderBrush="#E2E6EA">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TimeSpanTo12HourConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <CheckBox IsChecked="{Binding IsActive}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Doctor is currently active"
                           FontSize="13" Foreground="#5A6A75"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="0,11"/>
                <Button Grid.Column="2" Content="Save Doctor"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource DarkButton}"
                        Padding="0,11"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
