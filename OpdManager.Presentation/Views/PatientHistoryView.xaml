<Window x:Class="OpdManager.Presentation.Views.PatientHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OpdManager.Presentation.Converters"
        Title="Patient History"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Window.Resources>
        <converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter"/>
        <converters:StatusToColorConverter    x:Key="StatusToColorConverter"/>
        <converters:StatusToTextConverter     x:Key="StatusToTextConverter"/>
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Patient Info Card -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="20" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Opacity="0.07" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0" Width="56" Height="56"
                        Background="#E3F2FD" CornerRadius="28"
                        Margin="0,0,16,0">
                    <TextBlock Text="👤" FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#1C2833"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="📞 " FontSize="12"/>
                        <TextBlock Text="{Binding Patient.PhoneNumber}"
                                   FontSize="12" Foreground="#78909C"/>
                        <TextBlock Text="  •  " FontSize="12" Foreground="#78909C"/>
                        <TextBlock Text="🎂 " FontSize="12"/>
                        <TextBlock Text="{Binding Patient.DateOfBirth, StringFormat='MMM dd, yyyy'}"
                                   FontSize="12" Foreground="#78909C"/>
                    </StackPanel>
                </StackPanel>

                <!-- Total visits -->
                <Border Grid.Column="2" Background="#E8F5E9"
                        CornerRadius="10" Padding="16,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Visits"
                                   FontSize="11" Foreground="#78909C"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Appointment History header -->
        <TextBlock Grid.Row="1" Text="Appointment History"
                   FontSize="14" FontWeight="Bold"
                   Foreground="#1C2833" Margin="0,0,0,10"/>

        <!-- History DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Opacity="0.07" Color="#000000"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Appointments}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F5F5F5"
                      BorderThickness="0"
                      RowHeight="44" FontSize="13"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      CanUserResizeRows="False"
                      ColumnHeaderHeight="40">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#78909C"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderBrush" Value="#F0F0F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding AppointmentDate, StringFormat='MMM dd, yyyy'}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding TimeSlot,
                                                  Converter={StaticResource TimeSpanTo12HourConverter}}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Doctor"
                                        Binding="{Binding DoctorName}" Width="*"/>
                    <DataGridTextColumn Header="Specialty"
                                        Binding="{Binding DoctorSpecialty}" Width="120"/>
                    <DataGridTextColumn Header="Wait (min)"
                                        Binding="{Binding WaitingMinutes}" Width="90"/>
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3"
                                        HorizontalAlignment="Left" Margin="16,0"
                                        Background="{Binding Status,
                                                     Converter={StaticResource StatusToColorConverter}}">
                                    <TextBlock
                                        Text="{Binding Status,
                                               Converter={StaticResource StatusToTextConverter}}"
                                        FontSize="11" FontWeight="Medium"
                                        Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Notes"
                                        Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" Padding="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="#78909C">
                    <Run Text="Page "/>
                    <Run Text="{Binding CurrentPage}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalPages}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="«" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource PageBtn}" Margin="0,0,4,0"/>
                    <Border Background="White" CornerRadius="6"
                            BorderBrush="#1565C0" BorderThickness="1"
                            Width="32" Height="32" Margin="0,0,4,0">
                        <TextBlock Text="{Binding CurrentPage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#1565C0"/>
                    </Border>
                    <Button Content="»" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource PageBtn}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>