<UserControl x:Class="OpdManager.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Reports" Style="{StaticResource PageTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Export and print appointment reports"
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,24"/>

            <!-- Loading -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    Background="#EBF2FA" CornerRadius="7"
                    Padding="14,8" Margin="0,0,0,16" HorizontalAlignment="Left">
                <TextBlock Text="⏳  Generating report…"
                           FontSize="12" Foreground="#1A56A0"/>
            </Border>

            <!-- Date range -->
            <Border Style="{StaticResource Panel}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Date Range" FontSize="14"
                               FontWeight="Bold" Foreground="#1A2530"
                               Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="From:"
                                   VerticalAlignment="Center"
                                   Foreground="#5A6A75" Margin="0,0,10,0"
                                   FontSize="13"/>
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding FromDate}"
                                    FontSize="13" BorderBrush="#E2E6EA"/>
                        <TextBlock Grid.Column="2" Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#94A3B0"/>
                        <TextBlock Grid.Column="3" Text="To:"
                                   VerticalAlignment="Center"
                                   Foreground="#5A6A75" Margin="0,0,10,0"
                                   FontSize="13"/>
                        <DatePicker Grid.Column="4"
                                    SelectedDate="{Binding ToDate}"
                                    FontSize="13" BorderBrush="#E2E6EA"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Export options -->
            <Border Style="{StaticResource Panel}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Export Options" FontSize="14"
                               FontWeight="Bold" Foreground="#1A2530"
                               Margin="0,0,0,20"/>
                    <UniformGrid Columns="3">

                        <!-- PDF -->
                        <Border Background="#F6FBF8" CornerRadius="10"
                                Padding="20" Margin="0,0,12,0"
                                BorderBrush="#C6E6D4" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="34"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="PDF Report"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1A2530"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"/>
                                <TextBlock Text="Professional table layout with header"
                                           FontSize="11" Foreground="#5A6A75"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <Button Content="Export PDF"
                                        Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Excel -->
                        <Border Background="#F5F8FF" CornerRadius="10"
                                Padding="20" Margin="0,0,12,0"
                                BorderBrush="#C6D6F0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="34"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Excel Report"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1A2530"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"/>
                                <TextBlock Text="Spreadsheet with auto column width"
                                           FontSize="11" Foreground="#5A6A75"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <Button Content="Export Excel"
                                        Command="{Binding ExportExcelCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Print -->
                        <Border Background="#FFFBF0" CornerRadius="10"
                                Padding="20"
                                BorderBrush="#F0DFA0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🖨️" FontSize="34"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Print Report"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1A2530"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"/>
                                <TextBlock Text="Send directly to printer"
                                           FontSize="11" Foreground="#5A6A75"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <Button Content="Print"
                                        Command="{Binding PrintCommand}"
                                        Style="{StaticResource WarnButton}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
