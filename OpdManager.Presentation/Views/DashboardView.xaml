<UserControl x:Class="OpdManager.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"   Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="20,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                      Opacity="0.055" Color="#1A2530"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Header row -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="⟳  Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource DarkButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Alert banner (visible when waiting > threshold) -->
            <Border Visibility="{Binding HasWaitingAlert, Converter={StaticResource BoolToVisibility}}"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B" BorderThickness="0,0,0,0"
                    CornerRadius="9" Padding="16,11"
                    Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="⚠️"
                               FontSize="16" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding AlertMessage}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#92400E"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Loading -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Background="#EBF2FA" CornerRadius="7"
                    Padding="14,8" Margin="0,0,0,14"
                    HorizontalAlignment="Left">
                <TextBlock Text="⏳  Loading stats…"
                           FontSize="12" Foreground="#1A56A0"/>
            </Border>

            <!-- ── Row 1: Patient flow (4 cards, highest priority) ── -->
            <TextBlock Text="PATIENT FLOW TODAY"
                       FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B0" 
                       Margin="2,0,0,10"/>

            <UniformGrid Columns="4" Margin="0,0,0,14">

                <!-- Total -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Patients" FontSize="11"
                                   Foreground="#5A6A75" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPatientsToday}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="#1A2530" Margin="0,6,0,4"/>
                        <Border Background="#EBF2FA" CornerRadius="5"
                                Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="Scheduled today"
                                       FontSize="10" Foreground="#1A56A0"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Waiting — most urgent, amber accent -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Waiting" FontSize="11"
                                   Foreground="#5A6A75" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WaitingPatients}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="#B45309" Margin="0,6,0,4"/>
                        <Border Background="#FEF3C7" CornerRadius="5"
                                Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="In waiting room"
                                       FontSize="10" Foreground="#B45309"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- In Progress -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="In Progress" FontSize="11"
                                   Foreground="#5A6A75" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InProgressPatients}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="#1A56A0" Margin="0,6,0,4"/>
                        <Border Background="#EBF2FA" CornerRadius="5"
                                Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="With doctor now"
                                       FontSize="10" Foreground="#1A56A0"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Completed -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Completed" FontSize="11"
                                   Foreground="#5A6A75" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CompletedPatients}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="#1D6B3A" Margin="0,6,0,4"/>
                        <Border Background="#E6F4EC" CornerRadius="5"
                                Padding="7,3" HorizontalAlignment="Left">
                            <TextBlock Text="Done today"
                                       FontSize="10" Foreground="#1D6B3A"/>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Row 2: Operational stats (3 cards) ── -->
            <TextBlock Text="OPERATIONAL"
                       FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B0"
                       Margin="2,8,0,10"/>

            <UniformGrid Columns="3" Margin="0,0,0,0">

                <!-- Avg wait -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Avg Waiting Time" FontSize="11"
                                       Foreground="#5A6A75" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding AverageWaitingMinutes, StringFormat='{}{0:F0}'}"
                                           FontSize="38" FontWeight="Bold"
                                           Foreground="#1A2530"/>
                                <TextBlock Text=" min" FontSize="16"
                                           Foreground="#94A3B0"
                                           VerticalAlignment="Bottom"
                                           Margin="2,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Mini icon -->
                        <Border Grid.Column="1" Background="#F6F7F9"
                                CornerRadius="8" Width="40" Height="40"
                                VerticalAlignment="Top">
                            <TextBlock Text="⏱" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active doctors -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Active Doctors" FontSize="11"
                                       Foreground="#5A6A75" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveDoctors}"
                                       FontSize="38" FontWeight="Bold"
                                       Foreground="#1A2530" Margin="0,6,0,4"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F6F7F9"
                                CornerRadius="8" Width="40" Height="40"
                                VerticalAlignment="Top">
                            <TextBlock Text="👨‍⚕️" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Open issues -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Open Issues" FontSize="11"
                                       Foreground="#5A6A75" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OpenIssues}"
                                       FontSize="38" FontWeight="Bold"
                                       Margin="0,6,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1A2530"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OpenIssues}" Value="0">
                                                <Setter Property="Foreground" Value="#1D6B3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F6F7F9"
                                CornerRadius="8" Width="40" Height="40"
                                VerticalAlignment="Top">
                            <TextBlock Text="⚠" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
