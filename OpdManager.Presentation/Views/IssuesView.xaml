<UserControl x:Class="OpdManager.Presentation.Views.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Issues" FontSize="24"
                           FontWeight="Bold" Foreground="#1C2833"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" Foreground="#90A4AE" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="＋  Log Issue"
                    Command="{Binding AddCommand}"
                    Background="#C62828" Foreground="White"
                    Style="{StaticResource ActionBtn}"
                    Padding="16,10"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                BorderBrush="#E0E0E0" BorderThickness="1"
                Padding="16,12" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#E8E8E8"
                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="#90A4AE"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="13" Foreground="#37474F"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Category" FontSize="10"
                               Foreground="#90A4AE" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding FilterCategory}"
                              FontSize="12" BorderBrush="#E0E0E0"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Status" FontSize="10"
                               Foreground="#90A4AE" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatusOption}"
                              DisplayMemberPath="Label"
                              FontSize="12" BorderBrush="#E0E0E0"/>
                </StackPanel>

                <Button Grid.Column="6" Content="Search"
                        Command="{Binding SearchCommand}"
                        Background="#C62828" Foreground="White"
                        Style="{StaticResource ActionBtn}" Padding="16,8"/>

                <Button Grid.Column="8" Content="✕ Clear"
                        Command="{Binding ClearSearchCommand}"
                        Background="#ECEFF1" Foreground="#546E7A"
                        Style="{StaticResource ActionBtn}" Padding="12,8"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="🔍  Mark In Review"
                    Command="{Binding ReviewCommand}"
                    Background="#E65100" Foreground="White"
                    Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
            <Button Content="✔  Close Issue"
                    Command="{Binding CloseCommand}"
                    Background="#2E7D32" Foreground="White"
                    Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
            <Button Content="🗑  Delete"
                    Command="{Binding DeleteCommand}"
                    Background="#C62828" Foreground="White"
                    Style="{StaticResource ActionBtn}"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="3" Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                  Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Issues}"
                      SelectedItem="{Binding SelectedIssue}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F5F5F5"
                      BorderThickness="0"
                      RowHeight="46" FontSize="13"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      SelectionMode="Single"
                      CanUserResizeRows="False"
                      ColumnHeaderHeight="42">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#78909C"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderBrush" Value="#F0F0F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <Setter Property="Foreground" Value="#1C2833"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Reported"
                                        Binding="{Binding ReportedAt, StringFormat='MMM dd, h:mm tt'}"
                                        Width="150"/>
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3"
                                        HorizontalAlignment="Left" Margin="16,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="InReview">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Open">
                                                        <Setter Property="Text" Value="● Open"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="InReview">
                                                        <Setter Property="Text" Value="● In Review"/>
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                        <Setter Property="Text" Value="● Closed"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Resolution"
                                        Binding="{Binding Resolution}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="4" Padding="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="#78909C">
                    <Run Text="Page "/>
                    <Run Text="{Binding CurrentPage}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalPages}"/>
                    <Run Text=" ("/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" issues)"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="«" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource PageBtn}" Margin="0,0,4,0"/>
                    <Border Background="White" CornerRadius="6"
                            BorderBrush="#C62828" BorderThickness="1"
                            Width="32" Height="32" Margin="0,0,4,0">
                        <TextBlock Text="{Binding CurrentPage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#C62828"/>
                    </Border>
                    <Button Content="»" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource PageBtn}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
