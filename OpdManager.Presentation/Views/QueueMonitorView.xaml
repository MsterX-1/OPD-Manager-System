<UserControl x:Class="OpdManager.Presentation.Views.QueueMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpdManager.Presentation.Converters"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:QueueStatusToColorConverter x:Key="QueueStatusToColor"/>
        <converters:QueueStatusToTextConverter  x:Key="QueueStatusToText"/>

        <Style x:Key="QueueCard" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding"      Value="14,12"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.055" Color="#1A2530"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Queue Monitor" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="⟳  Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource DarkButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="⏳  Waiting" Foreground="#5A6A75"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalWaiting}"
                               FontSize="34" FontWeight="Bold"
                               Foreground="#B45309" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="🔄  In Progress" Foreground="#5A6A75"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalInProgress}"
                               FontSize="34" FontWeight="Bold"
                               Foreground="#1A56A0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="✅  Completed" Foreground="#5A6A75"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalCompleted}"
                               FontSize="34" FontWeight="Bold"
                               Foreground="#1D6B3A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="📢  Call Next"
                    Command="{Binding CallNextCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="✅  Mark Done"
                    Command="{Binding MarkDoneCommand}"
                    Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
            <Button Content="⏭  Skip / No Show"
                    Command="{Binding SkipCommand}"
                    Style="{StaticResource GhostButton}"/>
        </StackPanel>

        <!-- 3-column Kanban -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Waiting -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#FEF3C7"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <TextBlock Text="⏳  Waiting"
                               Foreground="#B45309" FontWeight="Bold" FontSize="13"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding WaitingQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QueueCard}"
                                        MouseLeftButtonUp="QueueCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#B45309"
                                                CornerRadius="7" Width="38" Height="38"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding QueueNumber}"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding PatientName}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#1A2530"/>
                                            <TextBlock Text="{Binding DoctorName}"
                                                       FontSize="11" Foreground="#5A6A75"/>
                                            <TextBlock FontSize="11" Foreground="#94A3B0"
                                                       Margin="0,2,0,0">
                                                <Run Text="Wait: "/>
                                                <Run Text="{Binding WaitingMinutes}"/>
                                                <Run Text=" min"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- In Progress -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#EBF2FA"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <TextBlock Text="🔄  In Progress"
                               Foreground="#1A56A0" FontWeight="Bold" FontSize="13"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InProgressQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QueueCard}"
                                        MouseLeftButtonUp="QueueCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A56A0"
                                                CornerRadius="7" Width="38" Height="38"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding QueueNumber}"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding PatientName}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#1A2530"/>
                                            <TextBlock Text="{Binding DoctorName}"
                                                       FontSize="11" Foreground="#5A6A75"/>
                                            <TextBlock FontSize="11" Foreground="#94A3B0"
                                                       Margin="0,2,0,0">
                                                <Run Text="Waited: "/>
                                                <Run Text="{Binding WaitingMinutes}"/>
                                                <Run Text=" min"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Completed -->
            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" Background="#E6F4EC"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <TextBlock Text="✅  Completed"
                               Foreground="#1D6B3A" FontWeight="Bold" FontSize="13"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CompletedQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QueueCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D6B3A"
                                                CornerRadius="7" Width="38" Height="38"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding QueueNumber}"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding PatientName}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#1A2530"/>
                                            <TextBlock Text="{Binding DoctorName}"
                                                       FontSize="11" Foreground="#5A6A75"/>
                                            <TextBlock FontSize="11" Foreground="#94A3B0"
                                                       Margin="0,2,0,0">
                                                <Run Text="Total wait: "/>
                                                <Run Text="{Binding WaitingMinutes}"/>
                                                <Run Text=" min"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
