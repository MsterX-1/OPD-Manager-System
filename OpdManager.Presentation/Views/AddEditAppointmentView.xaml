<Window x:Class="OpdManager.Presentation.Views.AddEditAppointmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OpdManager.Presentation.Converters"
        Title="{Binding Title}"
        Height="580" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">

	<Window.Resources>
		<converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter"/>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>

		<Style x:Key="FormLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#546E7A"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<!-- Placeholder style — uses Tag for placeholder text -->
		<Style x:Key="PlaceholderTextBox" TargetType="TextBox">
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderBrush" Value="#E0E0E0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#37474F"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
							<Grid>
								<TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#B0BEC5"
                                           FontSize="{TemplateBinding FontSize}"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
								<ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="Text" Value=""/>
									<Condition Property="IsFocused" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Border Margin="24">
			<StackPanel>

				<!-- Doctor with placeholder overlay -->
				<TextBlock Text="Doctor" Style="{StaticResource FormLabel}"/>
				<Grid Margin="0,0,0,16">
					<ComboBox ItemsSource="{Binding Doctors}"
                              SelectedItem="{Binding SelectedDoctor}"
                              DisplayMemberPath="Name"
                              Padding="12,10" FontSize="13"
                              BorderBrush="#E0E0E0"/>
					<TextBlock Text="Select a doctor..."
                               Foreground="#B0BEC5"
                               FontSize="13"
                               Padding="14,11"
                               IsHitTestVisible="False">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedDoctor}" Value="{x:Null}">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<!-- Patient Search with placeholder -->
				<TextBlock Text="Patient" Style="{StaticResource FormLabel}"/>
				<TextBox Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource PlaceholderTextBox}"
                         Tag="Search patient by name or phone..."
                         Margin="0,0,0,4"/>

				<!-- Search Results Dropdown -->
				<Border Visibility="{Binding ShowPatientResults, Converter={StaticResource BoolToVis}}"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,4" MaxHeight="150">
					<ListBox ItemsSource="{Binding PatientResults}"
                             DisplayMemberPath="FullName"
                             BorderThickness="0"
                             FontSize="13">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="12,8"/>
								<Setter Property="Cursor" Value="Hand"/>
								<EventSetter Event="MouseLeftButtonUp"
                                             Handler="PatientResult_Click"/>
							</Style>
						</ListBox.ItemContainerStyle>
					</ListBox>
				</Border>

				<!-- Quick Add toggle -->
				<Button Content="＋ New patient (quick add)"
                        Command="{Binding ToggleQuickAddCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#1565C0" FontSize="12"
                        Cursor="Hand" HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>

				<!-- Quick Add Form -->
				<Border Visibility="{Binding ShowQuickAdd, Converter={StaticResource BoolToVis}}"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
					<StackPanel>
						<TextBlock Text="New Patient" FontWeight="SemiBold"
                                   FontSize="13" Margin="0,0,0,8"/>
						<TextBox Text="{Binding NewPatientName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Full name *"
                                 Margin="0,0,0,8"/>
						<TextBox Text="{Binding NewPatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Phone number (optional)"
                                 Margin="0,0,0,8"/>
						<Button Content="Create Patient"
                                Command="{Binding QuickAddPatientCommand}"
                                Background="#1C2833" Foreground="White"
                                BorderThickness="0" Padding="12,8"
                                Cursor="Hand" HorizontalAlignment="Left">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="Opacity" Value="0.4"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>
				</Border>

				<!-- Date -->
				<TextBlock Text="Date" Style="{StaticResource FormLabel}"/>
				<DatePicker SelectedDate="{Binding AppointmentDate}"
                            FontSize="13" Margin="0,0,0,16"
                            BorderBrush="#E0E0E0"/>

				<!-- Time Slot -->
				<TextBlock Text="Time Slot" Style="{StaticResource FormLabel}"/>
				<ComboBox ItemsSource="{Binding TimeSlots}"
                          SelectedItem="{Binding SelectedTimeSlot}"
                          Padding="12,10" FontSize="13"
                          BorderBrush="#E0E0E0"
                          Margin="0,0,0,16">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource TimeSpanTo12HourConverter}}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!-- Notes with placeholder -->
				<TextBlock Text="Notes (optional)" Style="{StaticResource FormLabel}"/>
				<TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource PlaceholderTextBox}"
                         Tag="Add any notes here..."
                         Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,24"/>

				<!-- Buttons -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Background="#ECEFF1" Foreground="#546E7A"
                            BorderThickness="0" Padding="0,12" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Grid.Column="2" Content="Save Appointment"
                            Command="{Binding SaveCommand}"
                            Background="#1C2833" Foreground="White"
                            BorderThickness="0" Padding="0,12" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsEnabled" Value="False">
										<Setter Property="Background" Value="#B0BEC5"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Grid>
			</StackPanel>
		</Border>
	</ScrollViewer>
</Window>