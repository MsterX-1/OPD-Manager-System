<Application x:Class="OpdManager.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════════════════
             DESIGN TOKENS
             Primary:  #1A56A0  (calm clinical blue)
             Surface:  #F6F7F9  (page background, tinted off-white)
             Panel:    #FFFFFF  (card / panel backgrounds)
             Sidebar:  #17222D  (deep navy, not pure black)
             Border:   #E2E6EA  (subtle dividers)
             TextMain: #1A2530  (near-black, tinted)
             TextMid:  #5A6A75  (secondary labels)
             TextDim:  #94A3B0  (placeholders, timestamps)
             StatusOK:    #1D6B3A  text / #E6F4EC bg
             StatusWarn:  #B45309  text / #FEF3C7 bg
             StatusErr:   #B91C1C  text / #FEE2E2 bg
             StatusInfo:  #1A56A0  text / #EBF2FA bg
        ═══════════════════════════════════════════════════════ -->

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ── Shared button template ── -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── Primary button (dark fill) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"  Value="#1A56A0"/>
            <Setter Property="Foreground"  Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── Danger button ── -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"  Value="#B91C1C"/>
            <Setter Property="Foreground"  Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── Warning button ── -->
        <Style x:Key="WarnButton" TargetType="Button">
            <Setter Property="Background"  Value="#B45309"/>
            <Setter Property="Foreground"  Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── Success button ── -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background"  Value="#1D6B3A"/>
            <Setter Property="Foreground"  Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── Ghost button (secondary, outline feel) ── -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"  Value="#ECF0F4"/>
            <Setter Property="Foreground"  Value="#3A4A56"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── Dark button (sidebar header actions) ── -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background"  Value="#17222D"/>
            <Setter Property="Foreground"  Value="#FAFCFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template"    Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ── TextBox with placeholder (Tag = placeholder text) ── -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#E2E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#1A2530"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B0"
                                           FontSize="{TemplateBinding FontSize}"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text"      Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Shared panel (card) style ── -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background"   Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1"
                                      Opacity="0.06" Color="#1A2530"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid column header ── -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"    Value="#FFFFFF"/>
            <Setter Property="Foreground"    Value="#5A6A75"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="Padding"       Value="14,0"/>
            <Setter Property="BorderBrush"   Value="#E2E6EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- ── DataGrid cell ── -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"      Value="#1A2530"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF2FA"/>
                    <Setter Property="Foreground" Value="#1A2530"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Page heading ── -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A2530"/>
        </Style>

        <!-- ── Page subtitle ── -->
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#94A3B0"/>
            <Setter Property="Margin"     Value="0,3,0,0"/>
        </Style>

    </Application.Resources>
</Application>
