<Window x:Class="OpdManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpdManager.Presentation.Views"
        xmlns:vm="clr-namespace:OpdManager.Presentation.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="OPD Manager" Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">

    <Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="#7B96A9"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="14,11"/>
            <Setter Property="FontSize"                Value="13.5"/>
            <Setter Property="FontWeight"              Value="Medium"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F3040"/>
                                <Setter Property="Foreground" Value="#D6E4EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active nav item -->
        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="#1F3040"/>
            <Setter Property="Foreground" Value="#FAFCFF"/>
        </Style>

        <!-- Utility nav item (smaller, dimmer) -->
        <Style x:Key="NavItemUtil" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="#506070"/>
            <Setter Property="Padding"    Value="14,9"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="#17222D">
            <DockPanel>

                <!-- Logo / Hospital name -->
                <Border DockPanel.Dock="Top"
                        Padding="20,26,20,18"
                        BorderBrush="#1F3040" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A56A0" CornerRadius="8"
                                    Width="36" Height="36"
                                    Margin="0,0,10,0">
                                <TextBlock Text="🏥" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HospitalNameText"
                                           Text="OPD Manager"
                                           Foreground="#EEF3F8"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dddd, MMM dd'}"
                                           Foreground="#4A6070"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Utility links at bottom (docked first so main nav fills middle) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16">
                    <Border BorderBrush="#1F3040" BorderThickness="0,1,0,0" Margin="4,8,4,8"/>
                    <Button Content="💾  Backup" Style="{StaticResource NavItemUtil}"
                            Click="BackupButton_Click"/>
                    <Button Content="📥  Restore" Style="{StaticResource NavItemUtil}"
                            Click="RestoreButton_Click" Margin="0,2,0,0"/>
                    <Button Content="⚙  Settings" Style="{StaticResource NavItemUtil}"
                            Click="SettingsButton_Click" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Main nav -->
                <StackPanel DockPanel.Dock="Top" Margin="10,14,10,0">

                    <Button Command="{Binding NavDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Dashboard">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavDoctorsCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Doctors">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👨‍⚕️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Doctors" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavPatientsCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Patients">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Patients" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavAppointmentsCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Appointments">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appointments" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavQueueMonitorCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Queue">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔢" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Queue Monitor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavIssuesCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Issues">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Issues" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavReportsCommand}" Margin="0,2,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Reports">
                                        <Setter Property="Background" Value="#1F3040"/>
                                        <Setter Property="Foreground" Value="#FAFCFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Border Grid.Column="1" Padding="28,24">
            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorViewModel}">
                        <views:DoctorsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AppointmentViewModel}">
                        <views:AppointmentsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:QueueMonitorViewModel}">
                        <views:QueueMonitorView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                        <views:IssuesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PatientViewModel}">
                        <views:PatientsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>
