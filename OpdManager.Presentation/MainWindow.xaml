<Window x:Class="OpdManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpdManager.Presentation.Views"
        xmlns:vm="clr-namespace:OpdManager.Presentation.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="OPD Manager" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263238"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1C2833" CornerRadius="0">
            <DockPanel>
                <!-- Logo area -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                        BorderBrush="#263238" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="🏥" FontSize="28"/>
                        <TextBlock Text="OPD Manager"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dddd, MMM dd'}"
                                   Foreground="#607D8B"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Nav Items -->
                <StackPanel DockPanel.Dock="Top" Margin="12,16,12,0">

                    <Button Content="📊  Dashboard"
                            Command="{Binding NavDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Dashboard">
                                        <Setter Property="Background" Value="#263238"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="👨‍⚕️  Doctors"
                            Command="{Binding NavDoctorsCommand}"
                            Margin="0,4,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Doctors">
                                        <Setter Property="Background" Value="#263238"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="📅  Appointments"
                            Command="{Binding NavAppointmentsCommand}"
                            Margin="0,4,0,0">  
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Appointments">
                                        <Setter Property="Background" Value="#263238"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="🔢  Queue Monitor"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,4,0,0"/>
                    <Button Content="⚠️  Issues"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,4,0,0"/>
                    <Button Content="📤  Reports"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,4,0,0"/>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="24">
            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorViewModel}">
                        <views:DoctorsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AppointmentViewModel}">
                        <views:AppointmentsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>